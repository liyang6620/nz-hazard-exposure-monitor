# Copy to .env for local overrides. Never commit .env.
GEONET_POLL_ENABLED=true
RUN_STARTUP_HOUSEKEEPING=true
EVENT_PROCESSING_TIMEOUT_MINUTES=60
EVENT_PROCESSING_BATCH_SIZE=100
NZHEM_SITE_ASSETS_ROOT=
NOTIFICATION_EMAIL=owner@example.invalid
FAILURE_ALERT_GMAIL=
MAIL_FROM=nzhem@example.invalid
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
APPROVAL_TOKEN_KEY=
REVIEW_BASE_URL=http://127.0.0.1:8080/review
ARCGIS_API_KEY=
ARCGIS_PUBLISHER_ENABLED=false
ARCGIS_STATIC_MAPS_ENABLED=false
ARCGIS_API_KEY_NAME=ARCGIS_API_KEY
# Optional public browser key restricted to basemaps.linz.govt.nz and this site's origin.
VITE_LINZ_BASEMAPS_API_KEY=
LINZ_API_KEY=
STATSNZ_API_KEY=
REFERENCE_PAGE_SIZE=250
REFERENCE_MIN_FREE_DISK_GB=20
REFERENCE_MAX_RSS_MB=768
DUCKDB_MEMORY_LIMIT_MB=512
REFERENCE_EXPORT_CANDIDATE_LIMIT=5000
REFERENCE_EXPORT_WORK_RESERVE_GB=5

# M7 Snowflake benchmark (fill only after the offline PR is merged and trial exists).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=NZHEM_BENCHMARK_USER
SNOWFLAKE_PRIVATE_KEY_PATH=.local/snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_RSA_PUBLIC_KEY=
SNOWFLAKE_TRIAL_CREDIT_QUOTA=

