model Model
	culture: en-NZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-NZ
	dataAccessOptions
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0
annotation PBI_ProTooling = ["DevMode"]

ref table dim_event
ref table dim_region
ref table dim_date
ref table dim_mmi_band
ref table 'MMI Threshold'
ref table fct_event_summary
ref table fct_exposure
ref table fct_map
ref table fct_accumulation
ref table fct_validation
ref table fct_health
ref table fct_status
ref table fct_source
ref table _Measures
