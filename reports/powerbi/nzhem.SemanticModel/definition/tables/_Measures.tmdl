table _Measures
	lineageTag: 79a7a6ba-7769-536a-ab2c-e3950fbb693d

	/// Selected minimum intensity; 4–8, default 6.
	measure 'MMI Threshold Selected' = SELECTEDVALUE('MMI Threshold'[MMI Threshold], 6)
		formatString: 0
		displayFolder: 01 Exposure
		lineageTag: 9761a4fd-928a-5f5e-acd4-0a202d0ae475

	/// Event-time buildings for live events or current buildings for historical replays in cells at or above the selected MMI threshold.
	measure 'Exposed Buildings' = VAR threshold = [MMI Threshold Selected] RETURN COALESCE(CALCULATE(SUM(fct_exposure[Buildings]), KEEPFILTERS(fct_exposure[Band Key] >= threshold)), 0)
		formatString: #,0
		displayFolder: 01 Exposure
		lineageTag: 67a94066-2bf0-5b73-93a9-b0cff7041253

	/// Building footprint area in square metres at or above the selected MMI threshold.
	measure 'Exposed Footprint m2' = VAR threshold = [MMI Threshold Selected] RETURN CALCULATE(SUM(fct_exposure[Footprint m2]), KEEPFILTERS(fct_exposure[Band Key] >= threshold))
		formatString: #,0
		displayFolder: 01 Exposure
		lineageTag: 860f33b0-41c4-5acc-a194-f407115146dd

	/// 2023 allocated population in cells at or above the selected MMI threshold, rounded to people.
	measure 'Exposed Population' = VAR threshold = [MMI Threshold Selected] RETURN COALESCE(ROUND(CALCULATE(SUM(fct_exposure[People]), KEEPFILTERS(fct_exposure[Band Key] >= threshold)), 0), 0)
		formatString: #,0
		displayFolder: 01 Exposure
		lineageTag: fabd96b1-fa53-509f-b4a8-5870f4fe2611

	/// Share of all current buildings in the selected authority, region or nation; the denominator includes zero-exposure areas hidden from the matrix. Unavailable for live events without a regional stock denominator.
	measure '% Region Buildings Exposed' = IF(HASONEVALUE(dim_event[Event ID]), VAR selected_region = SELECTEDVALUE(dim_region[Region]) VAR selected_authority = SELECTEDVALUE(dim_region[Territorial Authority]) VAR stock = SWITCH(TRUE(), ISINSCOPE(dim_region[Territorial Authority]), CALCULATE(SUM(dim_region[Region Buildings]), REMOVEFILTERS(dim_region), dim_region[Region] = selected_region, dim_region[Territorial Authority] = selected_authority), HASONEVALUE(dim_region[Region]), CALCULATE(SUM(dim_region[Region Buildings]), REMOVEFILTERS(dim_region), dim_region[Region] = selected_region), CALCULATE(SUM(dim_region[Region Buildings]), REMOVEFILTERS(dim_region))) RETURN DIVIDE([Exposed Buildings], stock))
		formatString: 0.0%
		displayFolder: 02 Regions
		lineageTag: 9b21b860-ab59-5cad-9bc6-9975afe733c3

	/// Sum of current buildings multiplied by the number of historical MMI 6+ events per cell; repeated exposure, not unique buildings.
	measure 'Accumulated Building Exposures' = SUM(fct_accumulation[Accumulation Score])
		formatString: #,0
		displayFolder: 02 Regions
		lineageTag: 5663174c-e4bf-5578-937f-8686d5af379a

	/// Display name for repeated building exposure across ten historical replays; not unique buildings.
	measure 'Repeat Exposure' = [Accumulated Building Exposures]
		formatString: #,0
		displayFolder: 02 Regions
		lineageTag: 2685d11b-d56c-53a9-925f-71b5931473eb

	/// Current buildings in cells that experienced MMI 6+ in at least one replay.
	measure 'Buildings in Strong Cells' = SUM(fct_accumulation[Buildings in Strong Cells])
		formatString: #,0
		displayFolder: 02 Regions
		lineageTag: cf85128b-731b-58de-a1b4-6bccb6d4e989

	/// Highest populated-cell MMI in the filtered event set; never summed.
	measure 'Max MMI' = MAX(fct_event_summary[Maximum MMI])
		formatString: 0.0
		displayFolder: 03 Events
		lineageTag: d59bce0a-48bb-5120-8f72-40265cccdca7

	/// Highest GeoNet magnitude in the filtered event set.
	measure 'Magnitude' = MAX(dim_event[Magnitude])
		formatString: 0.0
		displayFolder: 03 Events
		lineageTag: 1ee03fb5-3e04-5245-9f2f-eb26323ce68f

	/// Number of distinct GeoNet earthquakes in filter context; a live assessment and replay of the same event count once.
	measure 'Event Count' = DISTINCTCOUNT(dim_event[GeoNet Event ID])
		formatString: #,0
		displayFolder: 03 Events
		lineageTag: d24d2d1e-378a-56f2-9f3a-47ffc7e27584

	/// Fractional calendar year of the earthquake origin, for the timeline X axis.
	measure 'Timeline Year' = IF([Visible History Event] = 1, MAX(dim_event[Timeline Year]))
		formatString: 0.0
		displayFolder: 03 Events
		lineageTag: a7b9376d-c3fd-5d69-a585-ab4c815a4853

	/// Station-weighted mean absolute error, recomputed from valid stations rather than summed event MAEs.
	measure 'Estimated MMI MAE' = DIVIDE(SUM(fct_validation[Absolute Error]), COUNTROWS(fct_validation))
		formatString: 0.000
		displayFolder: 04 Quality
		lineageTag: 943ad51b-cfc3-5249-b175-d6eadf813222

	/// Valid observed-intensity stations included in the MAE calculation.
	measure 'Validation Stations' = COUNTROWS(fct_validation)
		formatString: #,0
		displayFolder: 04 Quality
		lineageTag: 983c5ba3-ef3c-5f88-97c0-704ed887573f

	/// Last successful Azure housekeeping run captured in the read-only snapshot.
	measure 'Last Successful Run' = FORMAT(MAX(fct_health[Last Run]), "d MMM yyyy HH:mm", "en-NZ")
		formatString: @
		displayFolder: 04 Quality
		lineageTag: ad02e995-e5a8-5b48-aaeb-fc3f66be368a

	/// Age of the last Azure housekeeping run at snapshot time, in hours; not live.
	measure 'Hours Since Last Run' = DATEDIFF(MAX(fct_health[Last Run]), MAX(fct_health[Snapshot At]), HOUR)
		formatString: #,0
		displayFolder: 04 Quality
		lineageTag: 6aaba7d9-5893-54d1-8686-ff6d20d4a6e6

	/// Failed Azure housekeeping runs in the read-only snapshot.
	measure 'Failed Runs' = SUM(fct_health[Failed Runs])
		formatString: #,0
		displayFolder: 04 Quality
		lineageTag: a00ad122-e7e7-5829-9779-64c518515fc4

	/// Approximate Azure poison-queue depth at snapshot time, including acceptance-drill messages.
	measure 'Poison Messages' = SUM(fct_health[Poison Messages])
		formatString: #,0
		displayFolder: 04 Quality
		lineageTag: 24c78941-473e-5463-ae46-c86209ce9d8e

	/// Recent monitored events by terminal assessment state in the published site index.
	measure 'Live Event Count' = SUM(fct_status[Event Count])
		formatString: #,0
		displayFolder: 04 Quality
		lineageTag: 1302bd28-c966-5406-9485-67efe3994852

	/// Recent monitored events by published shaking source.
	measure 'Shaking Source Events' = SUM(fct_source[Event Count])
		formatString: #,0
		displayFolder: 04 Quality
		lineageTag: 4dd92e05-f65d-5458-9580-dff2f1296e34

	/// Largest building exposure in a single replay at the selected MMI threshold.
	measure 'Largest Event Exposure' = MAXX(VALUES(dim_event[Event ID]), [Exposed Buildings])
		formatString: #,0
		displayFolder: 03 Events
		lineageTag: dc631f6e-b294-5547-a914-45046f5d5675

	/// Event name associated with the largest single-event building exposure.
	measure 'Largest Exposure Event' = VAR ranked = TOPN(1, VALUES(dim_event[Event ID]), [Exposed Buildings], DESC, dim_event[Event ID], ASC) RETURN CONCATENATEX(ranked, CALCULATE(SELECTEDVALUE(dim_event[Event])), ", ")
		formatString: @
		displayFolder: 03 Events
		lineageTag: f618b8cc-e928-54d3-93ae-fcc62178c6d9

	/// Number of replay events reaching MMI 6 in a populated cell.
	measure 'Events with Damaging Shaking' = COUNTROWS(FILTER(VALUES(dim_event[Event ID]), CALCULATE([Max MMI]) >= 6))
		formatString: #,0
		displayFolder: 03 Events
		lineageTag: 6c0fdee9-e468-5b71-9b3e-fcd3344ed7b5

	/// Describes whether the denominator covers a selected region or the national stock.
	measure 'Share of Stock Title' = IF(HASONEVALUE(dim_region[Region]), "Share of Region Stock", "Share of National Stock")
		formatString: @
		displayFolder: 02 Regions
		lineageTag: 1af9639d-3774-5e75-b44a-8084d23bab6a

	/// Buildings at the event's stated exposure basis for map bubble size.
	measure 'Map Buildings' = SUM(fct_map[Buildings])
		formatString: #,0
		displayFolder: 05 Map
		lineageTag: 2eedf7c2-2b9e-5e5e-a6db-8ff5436a0df8

	/// Longitude of the H3 resolution 6 map point.
	measure 'Map Longitude' = AVERAGE(fct_map[Longitude])
		formatString: 0.000
		displayFolder: 05 Map
		lineageTag: 3975b853-e181-52ef-a27d-b0967e883de3

	/// Latitude of the H3 resolution 6 map point.
	measure 'Map Latitude' = AVERAGE(fct_map[Latitude])
		formatString: 0.000
		displayFolder: 05 Map
		lineageTag: 501aace6-1590-5777-903f-4e8966043590

	/// Longitude of the regional accumulation centroid.
	measure 'Regional Map Longitude' = AVERAGE(fct_accumulation[Longitude])
		formatString: 0.000
		displayFolder: 05 Map
		lineageTag: 579aac71-a826-504a-a22b-39d98d524199

	/// Latitude of the regional accumulation centroid.
	measure 'Regional Map Latitude' = AVERAGE(fct_accumulation[Latitude])
		formatString: 0.000
		displayFolder: 05 Map
		lineageTag: 9ae5c6a7-ffa6-5906-a7ec-c2267294b18c

	/// Explicit no-damaging-shaking status for a single assessed event.
	measure 'Exposure Status' = IF(HASONEVALUE(dim_event[Event ID]) && [Max MMI] < 6, "No damaging shaking", "Exposure assessed")
		formatString: @
		displayFolder: 03 Events
		lineageTag: 456527d3-347a-5838-a0ae-7d4ccf617ae7

	/// Building KPI label that follows the selected MMI threshold.
	measure 'Buildings Threshold Title' = "Buildings at MMI " & FORMAT([MMI Threshold Selected], "0") & "+"
		formatString: @
		displayFolder: 01 Exposure
		lineageTag: edac701e-9235-51b0-a854-bcc34d788a58

	/// Population KPI label that follows the selected MMI threshold.
	measure 'People Threshold Title' = "People at MMI " & FORMAT([MMI Threshold Selected], "0") & "+"
		formatString: @
		displayFolder: 01 Exposure
		lineageTag: c0d7e906-b072-50e3-881f-5e7c0e935c5f

	/// UTC time at which the read-only Power BI import snapshot was created.
	measure 'Snapshot Time' = "Snapshot " & FORMAT(MAX(fct_health[Snapshot At]), "d MMM yyyy HH:mm", "en-NZ") & " UTC"
		formatString: @
		displayFolder: 04 Quality
		lineageTag: 42639419-175a-5cfc-a154-fb26d1899285

	/// In the unfiltered history, keep the historical replay when a GeoNet event also has a live assessment; either group still shows its own row.
	measure 'Visible History Event' = VAR geonet_id = SELECTEDVALUE(dim_event[GeoNet Event ID]) VAR is_live = SELECTEDVALUE(dim_event[Event Group]) = "Live events" VAR replay_exists = CALCULATE(COUNTROWS(dim_event), REMOVEFILTERS(dim_event), dim_event[GeoNet Event ID] = geonet_id, dim_event[Event Group] = "Historical replays") > 0 RETURN IF(NOT ISFILTERED(dim_event[Event Group]) && is_live && replay_exists, BLANK(), 1)
		formatString: 0
		displayFolder: 03 Events
		lineageTag: 83bb3e81-9a2a-5e25-b21d-6fb4e42ae285

	/// Visual filter for event rankings with positive building exposure at the selected threshold.
	measure 'Positive Buildings' = IF([Exposed Buildings] > 0, 1)
		formatString: 0
		displayFolder: 03 Events
		lineageTag: fe385e8f-e783-539e-a16f-55e3322ce3c6

	/// Visual filter for event rankings with positive population exposure at the selected threshold.
	measure 'Positive People' = IF([Exposed Population] > 0, 1)
		formatString: 0
		displayFolder: 03 Events
		lineageTag: 3e2177c5-d704-56d3-833a-e8101fb34264

	/// Visual filter for mapped regions with positive building exposure; internal national live totals are excluded.
	measure 'Visible Exposed Region' = VAR region = SELECTEDVALUE(dim_region[Region]) RETURN IF(region <> "National" && region <> "Outside mapped regions" && [Exposed Buildings] > 0, 1)
		formatString: 0
		displayFolder: 02 Regions
		lineageTag: 830b7a9f-1637-514a-98c0-53511ce79358

	/// Visual filter for mapped regions or authorities with positive event or repeat exposure.
	measure 'Visible Regional Row' = VAR region = SELECTEDVALUE(dim_region[Region]) RETURN IF(region <> "National" && region <> "Outside mapped regions" && ([Exposed Buildings] > 0 || [Accumulated Building Exposures] > 0), 1)
		formatString: 0
		displayFolder: 02 Regions
		lineageTag: f14d60a3-cc3f-55af-836b-adef325d4e32

	/// Regional table title identifies the selected event threshold and the fixed repeat-exposure basis.
	measure 'Regional Threshold Title' = "Region and district exposure at MMI " & FORMAT([MMI Threshold Selected], "0") & "+ / repeat exposure across 10 replays (fixed MMI 6+)"
		formatString: @
		displayFolder: 02 Regions
		lineageTag: 8f7c2a2c-b4d2-55fd-9ff6-2ce7581defef

	/// Building ranking title follows the selected threshold.
	measure 'Event Ranking Title' = "Buildings at MMI " & FORMAT([MMI Threshold Selected], "0") & "+ by Event"
		formatString: @
		displayFolder: 03 Events
		lineageTag: 36e5d760-12b9-5e69-8602-f8a5756ea038

	/// Region ranking title follows the selected threshold.
	measure 'Region Ranking Title' = "Buildings at MMI " & FORMAT([MMI Threshold Selected], "0") & "+ by Region"
		formatString: @
		displayFolder: 02 Regions
		lineageTag: 85490c81-056a-5adf-ba6d-621090f43870

	/// Population ranking title follows the selected threshold.
	measure 'People Ranking Title' = "People at MMI " & FORMAT([MMI Threshold Selected], "0") & "+ by Event"
		formatString: @
		displayFolder: 03 Events
		lineageTag: 71d15c0f-8d15-5438-a432-53113eac54fd

	/// Comparison table title follows the selected threshold.
	measure 'Exposure Comparison Title' = "Event Comparison at MMI " & FORMAT([MMI Threshold Selected], "0") & "+ / Select a Row to Filter"
		formatString: @
		displayFolder: 03 Events
		lineageTag: 80326210-7b54-55a9-9bd6-125663d56297

	/// Event history chart title follows the selected threshold.
	measure 'History Trend Title' = "Event Time × Magnitude / Bubble Area = Buildings at MMI " & FORMAT([MMI Threshold Selected], "0") & "+"
		formatString: @
		displayFolder: 03 Events
		lineageTag: c4f9aee8-a16c-5aee-b7ea-fe9c2b287999

	/// Event history table title follows the selected threshold.
	measure 'History Table Title' = "Event Chronology / Buildings at MMI " & FORMAT([MMI Threshold Selected], "0") & "+"
		formatString: @
		displayFolder: 03 Events
		lineageTag: 87bfd7aa-8ef1-56f2-9533-b1fb15975596

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("Placeholder", "")
